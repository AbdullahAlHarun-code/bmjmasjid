# Copy to .env.local for local development. Never commit real secrets.

# --- Runtime ---
# Preferred: Node.js 22 LTS (Next.js 16 requires Node >= 20.9)
# NODE_ENV=development

# --- Site (optional overrides later) ---
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- PostgreSQL (manual donation-report submissions) ---
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/baitul_mamur
# After setting DATABASE_URL: npm run db:migrate
# Never commit real credentials.

# --- CSRF (donation-report POST) ---
# CSRF_SECRET=generate-a-long-random-string

# --- SSLCOMMERZ (deferred — server-side only) ---
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_IS_LIVE=false
# SSLCOMMERZ_IPN_URL=
