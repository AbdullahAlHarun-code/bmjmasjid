# Copy to .env.local for local development. Never commit real secrets.

# --- Runtime ---
# Preferred: Node.js 22 LTS (Next.js 16 requires Node >= 20.9)
# NODE_ENV=development

# --- Site (optional overrides later) ---
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- MySQL / MariaDB (manual donation-report submissions) ---
# DATABASE_URL=mysql://CPANEL_USER:PASSWORD@localhost:3306/CPANEL_DATABASE
# Percent-encode special characters in URL credentials. Use the full cPanel-prefixed names.
# DATABASE_SSL=true  # Required for remote databases; local cPanel connections follow host policy.
# After setting DATABASE_URL: npm run db:migrate
# Never commit real credentials.

# --- CSRF (donation-report POST) ---
# CSRF_SECRET=generate-a-long-random-string
# Exact public browser origin, required in production (scheme + host + optional port).
# APP_ORIGIN=https://YOUR_CONFIRMED_DOMAIN
# Only enable behind a trusted proxy that overwrites X-Real-IP and blocks direct app access.
# Otherwise reporting uses one conservative shared rate-limit bucket.
# DONATION_TRUST_PROXY_IP=false

# --- SSLCOMMERZ (deferred — server-side only) ---
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_IS_LIVE=false
# SSLCOMMERZ_IPN_URL=
