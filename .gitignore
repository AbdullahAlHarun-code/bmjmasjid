# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep secrets local; allow the example file
.env*
!.env.example

# production deploy bookkeeping (server-only)
.deployed-sha
.deploy.lock

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated browser audit evidence (uploaded as CI artifacts)
/docs/site-audit/
